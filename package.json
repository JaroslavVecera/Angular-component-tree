{
  "name": "angular-component-tree",
  "displayName": "Angular Component Tree",
  "description": "Navrhni strom Angular komponent (signal inputs, outputs, models) a vygeneruj ho jedním klikem.",
  "version": "0.0.3",
  "publisher": "jvecera",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaroslavVecera/Angular-component-tree.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "angular",
    "component",
    "generator",
    "signals"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "angularComponentTree",
          "title": "Angular Component Tree",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "angularComponentTree": [
        {
          "type": "webview",
          "id": "angularComponentTree.editor",
          "name": "Strom komponent"
        }
      ]
    },
    "commands": [
      {
        "command": "angularComponentTree.setTarget",
        "title": "Generate component structure",
        "category": "Angular Component Tree"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "angularComponentTree.setTarget",
          "when": "explorerResourceIsFolder",
          "group": "1_angularComponentTree@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
